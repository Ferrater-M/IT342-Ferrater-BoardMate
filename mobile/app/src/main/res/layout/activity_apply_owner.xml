<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F4F6">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- FORM CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:elevation="4dp"
            android:padding="30dp">

            <!-- HEADER -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Owner Partnership Application"
                android:textColor="#1E3A8A"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_gravity="center" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fill out the form below to list your property on BoardMate."
                android:textColor="#6B7280"
                android:textSize="14sp"
                android:layout_marginTop="8dp"
                android:layout_gravity="center" />

            <!-- PERSONAL INFO SECTION -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Personal Information"
                android:textColor="#111827"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="30dp"
                android:paddingBottom="8dp" />

            <!-- Full Name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Full Name"
                android:textColor="#374151"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp" />

            <EditText
                android:id="@+id/etFullName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/border_input"
                android:padding="12dp"
                android:textSize="15sp"
                android:hint="Enter your full name"
                android:layout_marginTop="6dp" />

            <!-- Email -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Email Address"
                android:textColor="#374151"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp" />

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/border_input"
                android:padding="12dp"
                android:textSize="15sp"
                android:hint="email@example.com"
                android:enabled="false"
                android:layout_marginTop="6dp" />

            <!-- Phone Number -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Contact Number"
                android:textColor="#374151"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp" />

            <EditText
                android:id="@+id/etPhoneNumber"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/border_input"
                android:padding="12dp"
                android:textSize="15sp"
                android:hint="e.g. 0912 345 6789"
                android:inputType="phone"
                android:layout_marginTop="6dp" />

            <!-- PROPERTY DETAILS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Property Details"
                android:textColor="#111827"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="30dp"
                android:paddingBottom="8dp" />

            <!-- House Name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Boarding House Name"
                android:textColor="#374151"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp" />

            <EditText
                android:id="@+id/etHouseName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/border_input"
                android:padding="12dp"
                android:textSize="15sp"
                android:hint="e.g. Sunset Heights Dormitory"
                android:layout_marginTop="6dp" />

            <!-- House Address -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Complete Address"
                android:textColor="#374151"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp" />

            <EditText
                android:id="@+id/etHouseAddress"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/border_input"
                android:padding="12dp"
                android:textSize="15sp"
                android:hint="Street, Barangay, City"
                android:layout_marginTop="6dp" />

            <!-- Total Rooms & Business Permit -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                android:gravity="end">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total Number of Rooms"
                        android:textColor="#374151"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etTotalRooms"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/border_input"
                        android:padding="12dp"
                        android:textSize="15sp"
                        android:inputType="number"
                        android:hint="0"
                        android:layout_marginTop="6dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Do you have a Business Permit?"
                        android:textColor="#374151"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/spinnerBusinessPermit"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/border_input"
                        android:padding="12dp"
                        android:layout_marginTop="6dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ADDITIONAL INFO -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Additional Information"
                android:textColor="#111827"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="30dp"
                android:paddingBottom="8dp" />

            <!-- Experience -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Management Experience"
                android:textColor="#374151"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp" />

            <EditText
                android:id="@+id/etExperience"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:background="@drawable/border_input"
                android:padding="12dp"
                android:textSize="15sp"
                android:gravity="top"
                android:hint="How long have you been managing boarding houses?"
                android:layout_marginTop="6dp" />

            <!-- Reason -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Why do you want to join BoardMate?"
                android:textColor="#374151"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp" />

            <EditText
                android:id="@+id/etReason"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:background="@drawable/border_input"
                android:padding="12dp"
                android:textSize="15sp"
                android:gravity="top"
                android:hint="Tell us your goals..."
                android:layout_marginTop="6dp" />

            <!-- BUTTONS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end"
                android:layout_marginTop="24dp">

                <Button
                    android:id="@+id/btnCancel"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="Cancel"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:background="#6B7280"
                    android:textColor="#FFFFFF"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:layout_marginEnd="12dp" />

                <Button
                    android:id="@+id/btnSubmit"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="Submit Application"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:background="@drawable/btn_primary_bg"
                    android:textColor="#FFFFFF"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
