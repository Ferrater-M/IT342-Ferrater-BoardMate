<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/rounded_white_card"
    android:padding="32dp"
    android:layout_margin="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="BOARDMATE"
        android:textColor="#0F172A"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:letterSpacing="0.15" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Official Payment Receipt"
        android:textColor="#64748B"
        android:textSize="12sp"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <View android:layout_width="match_parent" android:layout_height="2dp"
        android:background="#0F172A" android:layout_marginBottom="12dp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginBottom="8dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="Receipt #:" android:textColor="#475569" android:textSize="13sp" />
        <TextView android:id="@+id/tvReceiptId" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textColor="#0F172A" android:textSize="13sp" android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginBottom="8dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="Date:" android:textColor="#475569" android:textSize="13sp" />
        <TextView android:id="@+id/tvReceiptDate" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textColor="#0F172A" android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginBottom="8dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="Room:" android:textColor="#475569" android:textSize="13sp" />
        <TextView android:id="@+id/tvReceiptRoom" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textColor="#0F172A" android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginBottom="8dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="Billing Period:" android:textColor="#475569" android:textSize="13sp" />
        <TextView android:id="@+id/tvReceiptBillingPeriod" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textColor="#0F172A" android:textSize="13sp" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="2dp"
        android:background="#0F172A" android:layout_marginTop="8dp" android:layout_marginBottom="12dp" />

    <LinearLayout
        android:id="@+id/layoutReceiptItems"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="12dp" />

    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="#0F172A" android:layout_marginBottom="10dp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginBottom="4dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="TOTAL:"
            android:textColor="#0F172A" android:textStyle="bold" android:textSize="18sp" />
        <TextView android:id="@+id/tvReceiptTotal" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textColor="#0F172A"
            android:textStyle="bold" android:textSize="18sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="STATUS: PAID"
        android:textColor="#059669"
        android:textStyle="bold"
        android:textSize="13sp"
        android:gravity="end"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Thank you for your payment!"
        android:textColor="#64748B"
        android:textSize="12sp"
        android:gravity="center" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp">

        <Button
            android:id="@+id/btnPrintReceipt"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/input_field_bg"
            android:text="Print"
            android:textColor="#374151"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCloseReceipt"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/btn_primary_bg"
            android:text="Close"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>